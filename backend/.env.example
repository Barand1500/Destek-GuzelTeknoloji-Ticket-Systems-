NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://helpdesk_app:CHANGE_ME@127.0.0.1:3306/helpdesk
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE=26214400
# Development only: both local URLs work. In production leave only FRONTEND_URL.
DEV_FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_AGENT_EMAIL=agent@helpdesk.local
SEED_AGENT_PASSWORD=replace-with-another-strong-password
# SMTP is optional in development. Set these values in production to send notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASS is also accepted for providers that use this name.
# SMTP_SECURE=true is usually used with port 465; otherwise use false.
SMTP_SECURE=false
# mail@company.com or Company Support <mail@company.com>
SMTP_FROM=
# Incoming customer e-mail (IMAP). Leave blank to disable inbox synchronization.
# For Gmail use imap.gmail.com, port 993, and an App Password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=15
# Read recent messages even if they were opened in the mail client. Imported IDs are deduplicated.
IMAP_LOOKBACK_HOURS=24
