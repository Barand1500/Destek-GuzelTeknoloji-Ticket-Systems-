NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://helpdesk_app:CHANGE_ME@127.0.0.1:3306/helpdesk
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
# Enable only after creating real keys for the FRONTEND_URL hostname.
# The secret stays on the backend; never expose it as a VITE_ variable.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAX_FILE_SIZE=26214400
# Development only: both local URLs work. In production leave only FRONTEND_URL.
DEV_FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_AGENT_EMAIL=agent@helpdesk.local
SEED_AGENT_PASSWORD=replace-with-another-strong-password
# SMTP is optional in development. Set these values in production to send notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASS is also accepted for providers that use this name.
# SMTP_SECURE=true is usually used with port 465; otherwise use false.
SMTP_SECURE=false
# mail@company.com or Company Support <mail@company.com>
SMTP_FROM=
# Incoming customer e-mail (IMAP). Leave blank to disable inbox synchronization.
# For Gmail use imap.gmail.com, port 993, and an App Password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=15
# Read recent messages even if they were opened in the mail client. Imported IDs are deduplicated.
IMAP_LOOKBACK_HOURS=24
# External License Verification (lic.guzelteknoloji.com)
LICENSE_ENABLED=false
LICENSE_API_URL=https://lic.guzelteknoloji.com/api/erisim/paket-kontrol
# Must match PAKET_ERISIM_API_KEY in lic.guzelteknoloji.com/Backend/.env
LICENSE_API_KEY=
# At least LICENSE_DOMAIN or LICENSE_EMAIL is required when LICENSE_ENABLED=true
LICENSE_DOMAIN=destek.guzelteknoloji.com
LICENSE_EMAIL=
# Optional extra filters / checks
LICENSE_PRODUCT_ID=
LICENSE_PACKAGE_ID=
LICENSE_PRODUCT_NAME=
LICENSE_PACKAGE_NAME=
LICENSE_EXPECTED_KEY=
LICENSE_CACHE_TTL_MINUTES=15
LICENSE_GRACE_HOURS=24
