generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "js"
}
datasource db {
  provider = "mysql"
}
enum Role {
  ADMIN
  SUPERVISOR
  AGENT
  CUSTOMER
}
enum ConversationChannel {
  TICKET
  EMAIL
  SMS
  WHATSAPP
  LIVE_CHAT
  FORM
}
enum MessageType {
  CUSTOMER_MESSAGE
  AGENT_REPLY
  INTERNAL_NOTE
  SYSTEM
}
model SharedFile {
  id String @id @default(uuid())
  name String @db.VarChar(180)
  type String @db.VarChar(10)
  parent String?
  folder SharedFile? @relation("SharedFolders", fields: [parent], references: [id], onDelete: Restrict)
  children SharedFile[] @relation("SharedFolders")
  size Int?
  mimeType String?
  storageKey String? @unique
  icon String? @db.VarChar(30)
  color String? @db.VarChar(30)
  uploaderId String
  uploadedBy String
  createdAt DateTime @default(now())
  @@index([parent])
}

model User {
  id String @id @default(uuid())
  shareCreditsWithChildren Boolean @default(true)
  parentCustomerId String?
  parentCustomer User? @relation("CustomerFamily", fields: [parentCustomerId], references: [id], onDelete: Restrict)
  subCustomers User[] @relation("CustomerFamily")
  agreements Agreement[]
  customerLoginChallenge CustomerLoginChallenge?
  @@index([parentCustomerId])
  name String
  // Customer primary email and phone are independently checked by the transactional contact guard.
  // Legacy duplicates remain stored until explicitly resolved; login identity is a separate constraint.
  email String?
  phone String?
  // Only accounts that can sign in receive a unique login identity.
  loginEmail String? @unique
  company String?
  staffNote String? @db.Text
  extraPhones String? @db.VarChar(500)
  extraEmails String? @db.VarChar(500)
  deletedAt DateTime?
  passwordConfigured Boolean @default(false)
  passwordHash String
  role Role @default(CUSTOMER)
  accessRoleId String?
  accessRole AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  departments DepartmentAgent[]
  skills UserSkill[]
  customerConversations Conversation[] @relation("CustomerConversations")
  assignedConversations Conversation[] @relation("AssignedConversations")
  conversationAssignments ConversationAssignee[]
  messages ConversationMessage[]
  sessions Session[]
  passwordResets PasswordReset[]
  outboundMessages OutboundMessage[]
  logs ActivityLog[]
  creditSubscriptions CreditSubscription[]
  creditOrders CreditOrder[] @relation("CreditOrderOwner")
  requestedCreditOrders CreditOrder[] @relation("CreditOrderRequester")
  creditAlertReceipts CreditAlertReceipt[]
  notifications Notification[]
  savedReplies SavedReply[]
  attachments ConversationAttachment[]
  customerFiles CustomerAttachment[]
  projectGuideFiles ProjectGuideFile[]
  conversationParticipants ConversationParticipant[]
  messageMentions ConversationMessageMention[]
  @@index([email])
  @@index([phone])
}
model AccessRole {
  id String @id @default(uuid())
  name String @unique
  description String @default("") @db.VarChar(500)
  permissions Json
  scope String @default("DEPARTMENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
}
model SkillDefinition {
  id String @id @default(uuid())
  kind String @db.VarChar(10)
  name String @db.VarChar(80)
  normalizedKey String @db.VarChar(80)
  categoryId String?
  category SkillDefinition? @relation("SkillCategories", fields: [categoryId], references: [id], onDelete: Restrict)
  children SkillDefinition[] @relation("SkillCategories")
  rank Int @default(1)
  @@unique([kind, normalizedKey])
  @@index([categoryId])
}

model UserSkill {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(80)
  category String @db.VarChar(60)
  level String @db.VarChar(20)
  @@unique([userId, name])
}
model PasswordReset {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  tokenHash String? @unique
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(uuid())
  customerEmailVerifiedAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Department {
  id String @id @default(uuid())
  name String @unique
  isActive Boolean @default(true)
  deletedAt DateTime?
  agents DepartmentAgent[]
  conversations Conversation[]
}
model DepartmentAgent {
  departmentId String
  userId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([departmentId, userId])
  @@index([userId])
}
model Conversation {
  id String @id @default(uuid())
  creditCharge CreditCharge?
  number Int @unique @default(autoincrement())
  subject String
  websiteUrl String?
  websiteId String?
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  channel ConversationChannel @default(TICKET)
  replyChannels Json?
  source String @default("TICKET")
  searchSubject String
  customerId String
  customer User @relation("CustomerConversations", fields: [customerId], references: [id])
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  assignedAgentId String?
  assignedAgent User? @relation("AssignedConversations", fields: [assignedAgentId], references: [id])
  assignees ConversationAssignee[]
  status String @default("OPEN")
  priority String @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?
  resolvedAt DateTime?
  firstResponseAt DateTime?
  deletedAt DateTime?
  messages ConversationMessage[]
  incomingEmails IncomingEmail[]
  outboundMessages OutboundMessage[]
  tags ConversationTag[]
  notifications Notification[]
  externalMessages ExternalMessage[]
  participants ConversationParticipant[]
  formRequest FormRequest?
  formAccess FormAccess[]
  formLogin FormLoginChallenge?
  @@index([customerId, deletedAt, updatedAt])
  @@index([assignedAgentId, deletedAt, updatedAt])
  @@index([departmentId, status])
  @@index([deletedAt, updatedAt])
  @@index([channel, status])
  @@index([websiteId])
}
model FormSettings {
  id String @id @default("default")
  enabled Boolean @default(false)
  departmentId String?
  title String @default("Destek Talebi") @db.VarChar(100)
  requirePhone Boolean @default(false)
  requireCompany Boolean @default(false)
  requireSubject Boolean @default(true)
  requireMessage Boolean @default(true)
  fieldOrder Json?
  updatedAt DateTime @updatedAt
}
model FormSource {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  url String @db.VarChar(500)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
}
model FormRequest {
  conversationId String @id
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  email String @db.VarChar(254)
  name String @db.VarChar(100)
  phone String? @db.VarChar(30)
  company String? @db.VarChar(150)
  sourceId String? @db.VarChar(36)
  sourceName String? @db.VarChar(100)
  sourceUrl String? @db.VarChar(500)
  @@index([sourceId])
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}
model FormAccess {
  tokenHash String @id @db.VarChar(64)
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  email String @db.VarChar(254)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([conversationId, expiresAt])
}
model FormLoginChallenge {
  id String @id @default(uuid())
  conversationId String @unique
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  email String? @db.VarChar(254)
  deliveryChannel String @default("EMAIL") @db.VarChar(16)
  phone String? @db.VarChar(20)
  codeHash String @db.VarChar(64)
  attempts Int @default(0)
  requests Int @default(1)
  requestWindowAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
}
model FormEmailSession {
  tokenHash String @id @db.VarChar(64)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(20)
  deliveryChannel String @default("EMAIL") @db.VarChar(16)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([email, expiresAt])
}
model StatusOption {
  id String @id @default(uuid())
  code String @unique
  name String
  color String @default("#398571")
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, sortOrder])
  @@index([name])
}
model PriorityOption {
  id String @id @default(uuid())
  code String @unique
  name String
  color String @default("#64748b")
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, sortOrder])
  @@index([name])
}
model ConversationAssignee {
  conversationId String
  userId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([conversationId, userId])
  @@index([userId, conversationId])
}
model ConversationMessage {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id])
  authorId String
  author User @relation(fields: [authorId], references: [id])
  body String @db.Text
  type MessageType @default(CUSTOMER_MESSAGE)
  visibleInForm Boolean @default(false)
  createdAt DateTime @default(now())
  attachments ConversationAttachment[]
  mentions ConversationMessageMention[]
  @@index([conversationId, createdAt])
}
model ConversationParticipant {
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([conversationId, userId])
  @@index([userId, createdAt])
}
model ConversationMessageMention {
  messageId String
  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId])
  @@index([userId])
}
model IncomingEmail {
  id String @id @default(uuid())
  mailbox String @default("INBOX")
  uid Int
  messageId String?
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receivedAt DateTime @default(now())
  @@unique([mailbox, uid])
  @@unique([messageId])
  @@index([conversationId])
}
model ImapSyncState {
  id String @id @db.VarChar(64)
  mailbox String
  uidValidity String @db.VarChar(32)
  lastUid Int @default(0)
  leaseToken String? @db.VarChar(36)
  leaseUntil DateTime?
  updatedAt DateTime @updatedAt
  retries ImapSyncRetry[]
}
model OutboundMessage {
  id String @id @default(uuid())
  dedupeKey String? @unique
  channel String @db.VarChar(16)
  payload Json
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  status String @default("PENDING") @db.VarChar(16)
  sequence Int @default(0)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseToken String? @db.VarChar(36)
  leaseUntil DateTime?
  lastError String? @db.Text
  providerMessageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, availableAt])
  @@index([conversationId, channel, status])
  @@index([userId])
}
model ImapSyncRetry {
  syncId String @db.VarChar(64)
  sync ImapSyncState @relation(fields: [syncId], references: [id], onDelete: Cascade)
  uid Int
  attempts Int @default(1)
  nextAttemptAt DateTime
  lastError String @db.Text
  @@id([syncId, uid])
  @@index([syncId, nextAttemptAt])
}
model ActivityLog {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  action String
  entityType String @default("Conversation")
  entityId String
  ipAddress String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
}
model ConversationAttachment {
  id String @id @default(uuid())
  messageId String
  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  originalName String
  mimeType String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([messageId])
}
model CustomerAttachment {
  id String @id @default(uuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originalName String
  mimeType String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
}
model Tag {
  id String @id @default(uuid())
  name String @unique
  code String @unique
  color String @default("#64748b")
  conversations ConversationTag[]
}
model Website {
  id String @id @default(uuid())
  name String
  url String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversations Conversation[]
  guideFiles ProjectGuideFile[]
  @@index([isActive])
}
model ProjectGuideFile {
  id String @id @default(uuid())
  websiteId String
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id])
  originalName String
  mimeType String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([websiteId, createdAt])
  @@index([uploaderId])
}
model ConversationTag {
  conversationId String
  tagId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([conversationId, tagId])
  @@index([tagId])
}
model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type String
  title String
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, isRead, createdAt])
}
model SavedReply {
  id String @id @default(uuid())
  title String
  body String
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([authorId])
}
model TurnstileSettings {
  id String @id @default("default")
  enabled Boolean @default(false)
  siteKey String @default("") @db.VarChar(256)
  secretCiphertext String @db.Text
  updatedAt DateTime @updatedAt
}
model SystemSettings {
  id String @id @default("default")
  companyName String @default("Destek Merkezi")
  supportEmail String @default("")
  supportPhone String @default("")
  allowRegistration Boolean @default(true)
  presenceIdleMinutes Int @default(5)
  roleTemplates Json?
}
model ResponseTimeSettings {
  id String @id @default("default")
  responseFastFromMinutes Int @default(0)
  responseFastToMinutes Int @default(15)
  responseNormalFromMinutes Int @default(16)
  responseNormalToMinutes Int @default(60)
  responseLateFromMinutes Int @default(61)
  responseLateToMinutes Int @default(10080)
  responseFastColor String @default("#16715d")
  responseNormalColor String @default("#a86606")
  responseLateColor String @default("#c2413c")
  updatedAt DateTime @updatedAt
}
model NotificationSettings {
  id String @id @default("default")
  ticketCreatedSubject String @db.VarChar(191)
  ticketCreatedBody String @db.Text
  ticketReplySubject String @db.VarChar(191)
  ticketReplyBody String @db.Text
  updatedAt DateTime @updatedAt
}
model IntegrationSettings {
  id String @id @default("default")
  responseFastMinutes Int @default(15)
  responseNormalMinutes Int @default(60)
  responseFastColor String @default("#16715d")
  responseNormalColor String @default("#a86606")
  responseLateColor String @default("#c2413c")
  responseFastFromMinutes Int @default(0)
  responseFastToMinutes Int @default(15)
  responseNormalFromMinutes Int @default(16)
  responseNormalToMinutes Int @default(60)
  responseLateFromMinutes Int @default(61)
  responseLateToMinutes Int @default(10080)
  smtpEnabled Boolean @default(false)
  smtpHost String @default("")
  smtpPort Int @default(587)
  smtpSecure Boolean @default(false)
  smtpUser String @default("")
  smtpPassword String @default("")
  smtpFromAddress String @default("")
  smtpFromName String @default("")
  imapEnabled Boolean @default(false)
  incomingMessagesSince DateTime?
  imapConnectionName String @default("")
  imapHost String @default("")
  imapPort Int @default(993)
  imapSecure Boolean @default(true)
  imapAuthType String @default("BASIC")
  imapUser String @default("")
  imapPassword String @default("")
  imapMailbox String @default("INBOX")
  imapPollIntervalSeconds Int @default(60)
  imapCreateTickets Boolean @default(true)
  imapCreateReplies Boolean @default(true)
  imapDepartmentId String?
  smsEnabled Boolean @default(false)
  smsApiUser String @default("")
  smsApiPassword String @default("")
  smsSender String @default("")
  smsVirtualNumber String @default("")
  smsWebhookSecret String @default("")
  smsDepartmentId String?
  whatsappEnabled Boolean @default(false)
  whatsappAppId String @default("")
  whatsappAppSecret String @default("")
  whatsappPhoneNumberId String @default("")
  whatsappAccessToken String @default("") @db.VarChar(8192)
  whatsappVerifyToken String @default("")
  whatsappAuthTemplateName String @default("") @db.VarChar(60)
  whatsappAuthTemplateLanguage String @default("en") @db.VarChar(20)
  whatsappDepartmentId String?
  lastTestChannel String?
  lastTestSuccess Boolean?
  lastTestMessage String? @db.Text
  lastTestedAt DateTime?
  updatedAt DateTime @updatedAt
}
model ExternalMessage {
  id String @id @default(uuid())
  provider String
  externalId String
  channel ConversationChannel
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([provider, externalId])
  @@index([conversationId])
}

model Announcement {
  id String @id @default(uuid())
  authorId String
  authorName String
  title String
  body String @db.Text
  priority String
  departmentId String?
  departmentName String?
  eventAt DateTime?
  pinned Boolean @default(false)
  files Json
  createdAt DateTime @default(now())
  deliveries AnnouncementDelivery[]
  @@index([createdAt])
}
model AnnouncementDelivery {
  id String @id @default(uuid())
  announcementId String
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId String
  recipientName String
  address String?
  channel String
  status String @default("PENDING")
  error String? @db.Text
  @@unique([announcementId, userId, channel])
  @@index([status])
  @@index([userId, announcementId])
}

model AnnouncementTemplate {
  id String @id @default(uuid())
  label String
  title String
  body String @db.Text
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sortOrder, createdAt])
}

model Survey {
  id String @id @default(uuid())
  authorId String
  authorName String
  title String
  description String @default(dbgenerated("('')")) @db.Text
  anonymous Boolean @default(false)
  endsAt DateTime
  closedAt DateTime?
  questions Json
  channels Json
  createdAt DateTime @default(now())
  recipients SurveyRecipient[]
  responses SurveyResponse[]
  @@index([createdAt])
  @@index([endsAt])
}

model SurveyRecipient {
  id String @id @default(uuid())
  surveyId String
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId String
  recipientName String
  deliveryStatus Json
  @@unique([surveyId, userId])
  @@index([userId])
}

model SurveyResponse {
  id String @id @default(uuid())
  surveyId String
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId String
  respondentName String?
  answers Json
  createdAt DateTime @default(now())
  @@unique([surveyId, userId])
  @@index([surveyId, createdAt])
}

model Agreement {
 currency String @default("TRY") @db.VarChar(3)
 grantedOrder CreditOrder? @relation("OrderGrant")
 sourceSubscription CreditSubscription? @relation("SubscriptionSource")
 renewalRequested Boolean @default(false)
 alertReceipts CreditAlertReceipt[]
 id String @id @default(uuid())
 customerId String
 customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
 name String @db.VarChar(150)
 type String @db.VarChar(64)
 startsOn DateTime @db.Date
 endsOn DateTime @db.Date
 fee Decimal @db.Decimal(12, 2)
 credits Int
 usedCredits Int @default(0)
 deletedAt DateTime?
 cancelledAt DateTime?
 createdAt DateTime @default(now())
 charges CreditCharge[]
 @@index([customerId, endsOn])
}
model CreditCharge {
 id String @id @default(uuid())
 conversationId String @unique
 conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
 agreementId String?
 agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: Restrict)
 credits Int
 actorId String
 createdAt DateTime @default(now())
 @@index([agreementId, createdAt])
}

model CustomerLoginChallenge {
 id String @id @default(uuid())
 userId String @unique
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 email String @db.VarChar(254)
 codeHash String @db.VarChar(64)
 attempts Int @default(0)
 requests Int @default(1)
 requestWindowAt DateTime @default(now())
 expiresAt DateTime
 consumedAt DateTime?
}

model AgreementType {
 id String @id @default(uuid())
 name String @unique @db.VarChar(80)
 archivedAt DateTime?
 createdAt DateTime @default(now())
}

// Sales catalog only. No payment or credit creation occurs until provider integration.
model CreditSalesSettings {
 alertChannels Json?
 whatsappCreditTemplateName String @default("") @db.VarChar(120)
 whatsappCreditTemplateLanguage String @default("tr") @db.VarChar(20)
 alertsEnabled Boolean @default(true)
 lowCreditPercent Int @default(20)
 expiryNoticeDays Int @default(7)
 currency String @default("TRY") @db.VarChar(3)
 id String @id @default("default") @db.VarChar(32)
 enabled Boolean @default(false)
 unitPrice Decimal @default(1) @db.Decimal(10, 2)
 minCredits Int @default(1)
 maxCredits Int @default(10000)
 validityDays Int @default(365)
 updatedAt DateTime @updatedAt
}
model CreditSalesPlan {
 periodDays Int?
 periodName String? @db.VarChar(80)
 renewalRequested Boolean @default(false)
 currency String @default("TRY") @db.VarChar(3)
 id String @id @default(uuid())
 name String @db.VarChar(100)
 description String @db.Text
 periodMonths Int?
 price Decimal @db.Decimal(10, 2)
 credits Int
 active Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([active, createdAt])
}

model CreditOrder {
 reversals PaymentReversal[]
 subscriptionId String?
 subscription CreditSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
 periodNumber Int?
 periodStartsOn DateTime? @db.Date
 periodEndsOn DateTime? @db.Date
 grantedAgreementId String? @unique
 grantedAgreement Agreement? @relation("OrderGrant", fields: [grantedAgreementId], references: [id], onDelete: Restrict)
 paymentAttempts CreditPaymentAttempt[]
 paidAt DateTime?
 @@unique([subscriptionId, periodNumber])

 periodName String? @db.VarChar(80)
 renewalRequested Boolean @default(false)
 id String @id @default(uuid())
 number Int @unique @default(autoincrement())
 customerId String
 customer User @relation("CreditOrderOwner", fields: [customerId], references: [id], onDelete: Restrict)
 requestedById String
