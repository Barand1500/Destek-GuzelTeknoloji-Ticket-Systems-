generator client {
  provider = "prisma-client"
  output = "../../src/generated/prisma"
  importFileExtension = "js"
}
datasource db {
  provider = "mysql"
}
enum Role {
  ADMIN
  SUPERVISOR
  AGENT
  CUSTOMER
}
enum ConversationChannel {
  TICKET
  EMAIL
  SMS
  WHATSAPP
  LIVE_CHAT
}
enum MessageType {
  CUSTOMER_MESSAGE
  AGENT_REPLY
  INTERNAL_NOTE
  SYSTEM
}
model User {
  id String @id @default(uuid())
  name String
  // Contact information can belong to more than one person in a household or company.
  email String?
  phone String?
  // Only accounts that can sign in receive a unique login identity.
  loginEmail String? @unique
  company String?
  staffNote String?
  passwordHash String
  role Role @default(CUSTOMER)
  isActive Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  departments DepartmentAgent[]
  customerConversations Conversation[] @relation("CustomerConversations")
  assignedConversations Conversation[] @relation("AssignedConversations")
  messages ConversationMessage[]
  sessions Session[]
  logs ActivityLog[]
  notifications Notification[]
  savedReplies SavedReply[]
  attachments ConversationAttachment[]
  customerFiles CustomerAttachment[]
  @@index([email])
  @@index([phone])
}
model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Department {
  id String @id @default(uuid())
  name String @unique
  isActive Boolean @default(true)
  agents DepartmentAgent[]
  conversations Conversation[]
}
model DepartmentAgent {
  departmentId String
  userId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([departmentId, userId])
  @@index([userId])
}
model Conversation {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  subject String
  channel ConversationChannel @default(TICKET)
  searchSubject String
  customerId String
  customer User @relation("CustomerConversations", fields: [customerId], references: [id])
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  assignedAgentId String?
  assignedAgent User? @relation("AssignedConversations", fields: [assignedAgentId], references: [id])
  status String @default("OPEN")
  priority String @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?
  resolvedAt DateTime?
  firstResponseAt DateTime?
  deletedAt DateTime?
  incomingEmails IncomingEmail[]
  messages ConversationMessage[]
  tags ConversationTag[]
  notifications Notification[]
  externalMessages ExternalMessage[]
  @@index([customerId, deletedAt, updatedAt])
  @@index([assignedAgentId, deletedAt, updatedAt])
  @@index([departmentId, status])
  @@index([deletedAt, updatedAt])
  @@index([channel, status])
}
model StatusOption {
  id String @id @default(uuid())
  code String @unique
  name String
  color String @default("#398571")
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, sortOrder])
  @@index([name])
}
model PriorityOption {
  id String @id @default(uuid())
  code String @unique
  name String
  color String @default("#64748b")
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, sortOrder])
  @@index([name])
}
model ConversationMessage {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id])
  authorId String
  author User @relation(fields: [authorId], references: [id])
  body String @db.Text
  type MessageType @default(CUSTOMER_MESSAGE)
  createdAt DateTime @default(now())
  attachments ConversationAttachment[]
  @@index([conversationId, createdAt])
}
model IncomingEmail {
  id String @id @default(uuid())
  mailbox String @default("INBOX")
  uid Int
  messageId String?
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receivedAt DateTime @default(now())
  @@unique([mailbox, uid])
  @@unique([messageId])
  @@index([conversationId])
}
model ActivityLog {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  action String
  entityType String @default("Conversation")
  entityId String
  ipAddress String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
}
model ConversationAttachment {
  id String @id @default(uuid())
  messageId String
  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id])
  originalName String
  mimeType String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([messageId])
}
model CustomerAttachment {
  id String @id @default(uuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originalName String
  mimeType String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
}
model Tag {
  id String @id @default(uuid())
  name String @unique
  code String @unique
  color String @default("#64748b")
  conversations ConversationTag[]
}
model ConversationTag {
  conversationId String
  tagId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([conversationId, tagId])
  @@index([tagId])
}
model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type String
  title String
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, isRead, createdAt])
}
model SavedReply {
  id String @id @default(uuid())
  title String
  body String
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([authorId])
}
model SystemSettings {
  id String @id @default("default")
  companyName String @default("Destek Merkezi")
  supportEmail String @default("")
  supportPhone String @default("")
  allowRegistration Boolean @default(true)
}
model ResponseTimeSettings {
  id String @id @default("default")
  responseFastFromMinutes Int @default(0)
  responseFastToMinutes Int @default(15)
  responseNormalFromMinutes Int @default(16)
  responseNormalToMinutes Int @default(60)
  responseLateFromMinutes Int @default(61)
  responseLateToMinutes Int @default(10080)
  responseFastColor String @default("#16715d")
  responseNormalColor String @default("#a86606")
  responseLateColor String @default("#c2413c")
  updatedAt DateTime @updatedAt
}
model NotificationSettings {
  id String @id @default("default")
  ticketCreatedSubject String @db.VarChar(191)
  ticketCreatedBody String @db.Text
  ticketReplySubject String @db.VarChar(191)
  ticketReplyBody String @db.Text
  updatedAt DateTime @updatedAt
}
model IntegrationSettings {
  id String @id @default("default")
  smtpEnabled Boolean @default(false)
  smtpHost String @default("")
  smtpPort Int @default(587)
  smtpSecure Boolean @default(false)
  smtpUser String @default("")
  smtpPassword String @default("")
  smtpFromAddress String @default("")
  smtpFromName String @default("")
  imapEnabled Boolean @default(false)
  imapConnectionName String @default("")
  imapHost String @default("")
  imapPort Int @default(993)
  imapSecure Boolean @default(true)
  imapAuthType String @default("BASIC")
  imapUser String @default("")
  imapPassword String @default("")
  imapMailbox String @default("INBOX")
  imapPollIntervalSeconds Int @default(60)
  imapCreateTickets Boolean @default(true)
  imapCreateReplies Boolean @default(true)
  imapDepartmentId String?
  smsEnabled Boolean @default(false)
  smsApiUser String @default("")
  smsApiPassword String @default("")
  smsSender String @default("")
  smsVirtualNumber String @default("")
  smsWebhookSecret String @default("")
  smsDepartmentId String?
  whatsappEnabled Boolean @default(false)
  whatsappAppId String @default("")
  whatsappAppSecret String @default("")
  whatsappPhoneNumberId String @default("")
  whatsappAccessToken String @default("")
  whatsappVerifyToken String @default("")
  whatsappDepartmentId String?
  lastTestChannel String?
  lastTestSuccess Boolean?
  lastTestMessage String? @db.Text
  lastTestedAt DateTime?
  updatedAt DateTime @updatedAt
}
model ExternalMessage {
  id String @id @default(uuid())
  provider String
  externalId String
  channel ConversationChannel
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([provider, externalId])
  @@index([conversationId])
}
