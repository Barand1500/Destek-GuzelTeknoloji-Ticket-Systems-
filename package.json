{
  "name": "helpdesk",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "format": "prettier --write backend/src backend/tests frontend/src e2e *.json *.ts",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
